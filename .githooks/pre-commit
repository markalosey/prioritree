#!/usr/bin/env bash
# pre-commit — the commit backstop (GENERATED by scripts/generation/
# clarity_scaffold.py from hikari; regenerated at will, never hand-maintained).
#
# Check 1: staged .py files must pass pyright — the 0/0/0 bar
#          (a warning is an error waiting to happen). The strictness flags
#          ride the tree's own pyproject (the tane precedent's shape).
#
# PHASE 2 (named, pending): ruff zero-findings joins this hook when the
# tree's ruff backlog is sequenced to zero (the tane precedent's named-
# phase shape; the zero-ignore LAW stands — a new ignore is a ruling,
# never a convenience; until then the battery and review discipline
# govern ruff).
#
# Exemption: PRIORITREE_HOOK_BYPASS=1 skips all checks (bootstrap and
# coordinator-run bulk commits; prefer it over --no-verify).

if [ "$PRIORITREE_HOOK_BYPASS" = "1" ]; then
    exit 0
fi

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$STAGED_PY" ]; then
    exit 0
fi

PYRIGHT_OUT=$(uv run pyright $STAGED_PY 2>&1)
if ! echo "$PYRIGHT_OUT" | grep -q "0 errors, 0 warnings, 0 informations"; then
    echo "" >&2
    echo "=== pre-commit: pyright not at 0/0/0 on staged files ===" >&2
    echo "$PYRIGHT_OUT" >&2
    echo "The bar is zero errors AND zero warnings — a warning is an" >&2
    echo "error waiting to happen." >&2
    echo "Bypass for coordinator bulk commits: PRIORITREE_HOOK_BYPASS=1" >&2
    exit 1
fi

exit 0
